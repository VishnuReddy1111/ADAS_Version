              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-000000d69aec">
          <SHORT-NAME>BMC_MaxEnergieinhalt</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Maximaler  Energieinhalt der Batterie bei 100% NutzbarerSOC unter Beruecksichtigung der Verluste (I_RWDS)</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
