        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-0000011c0dad">
          <SHORT-NAME>BMC_MinDyn_Entladespannung</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">rechnerischer Wert: minimales, für eine Dauer von ~1s garantiertes Spannungsniveau, das unter Belastung mit BMC_Max_EntladeLeistung nicht unterschritten wird</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_BMC_MinDyn_Entladespannung</COMPU-METHOD-REF>
