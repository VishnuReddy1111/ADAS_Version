    <AR-PACKAGE UUID="626a01f5-0000-27be-64eb-27bed13a88c6">
      <SHORT-NAME>Signal</SHORT-NAME>
      <ELEMENTS>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-00000052fa04">
          <SHORT-NAME>AB_Abschaltanf_SIH_BF</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Die Insassenerkennung auf der Beifahrerseite fordert bei Übertemperatur eine Abschaltung der Sitzheizung an. Die Übertemperatur kann bei niederohmigen Nebenschlüssen der Sitzheizungsmatte als Folge von zu hohem resultierenden Strom auftreten.</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_AB_Abschaltanf_SIH_BF</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_AB_Abschaltanf_SIH_BF</DATA-CONSTR-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-00000002a302">
          <SHORT-NAME>AB_Anzeige_Fussg</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Anzeige für ausgelöste Fussgängerschutz-Aktuatorik</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_AB_Anzeige_Fussg</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_AB_Anzeige_Fussg</DATA-CONSTR-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-000000016bab">
          <SHORT-NAME>AB_Belegung_VB</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Belegungserkennung vorne Beifahrer. Wird in US-Steuergeräten über Bladder-Matte bedient, optional bei RdW, falls SBE_EuroNCAP entschieden wird.</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_AB_Belegung_VB</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_AB_Belegung_VB</DATA-CONSTR-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-00000081fe96">
          <SHORT-NAME>AB_Belegung_VF</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Belegungserkennung vorne Fahrer.</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_AB_Belegung_VF</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_AB_Belegung_VF</DATA-CONSTR-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-000000946102">
          <SHORT-NAME>AB_Belegung_VF_ext</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Das Signal kommuniziert den Status des Sitzbelegsensors Fahrer incl. dauerhafter Zustände mit Signalqualität ASIL A.</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_AB_Belegung_VF_ext</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_AB_Belegung_VF_ext</DATA-CONSTR-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-0000009c51fb">
          <SHORT-NAME>AB_Belegung_VF_ext_aktiv</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Kennzeichnet aktive Funktion "Erweiterte Sitzbelegdiagnose" für Signal AB_Belegung_VF_ext</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_AB_Belegung_VF_ext_aktiv</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_AB_Belegung_VF_ext_aktiv</DATA-CONSTR-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-000000016aff">
          <SHORT-NAME>AB_Crash_Int</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Crash_Intensität_1 = fahrzeugabhängige Reaktionen im Crash
Crash_Intensität_2 = fahrzeugabhängige Reaktionen im Crash
Crash_Intensität_3 = fahrzeugabhängige Reaktionen im Crash

Die jeweiligen fahrzeugabhängigen Reaktionen im Crash sind in einem separaten Doors Modul im Airbag-SG beschrieben.

Die Information bleibt bei jeder Schwellwert-überschreitung für ~10 s bestehen 
(Achtung: Energiereserve bei abgetrennter Batterie reicht worstcase nur für 150 ms)</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_AB_Crash_Int</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_AB_Crash_Int</DATA-CONSTR-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-0000000a17a6">
          <SHORT-NAME>AB_Deaktivierung_HV</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Deaktivierung des HV-Systems und der HV-Teilnehmer im Crash (u.a. Hybrid- und Elektrofahrzeuge)</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_AB_Deaktivierung_HV</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_AB_Deaktivierung_HV</DATA-CONSTR-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-00000131a934">
          <SHORT-NAME>AB_DeltaV_X_eCall</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Transmission of the DeltaV longitudinal during Crash (0-250ms) as additional information for eCall</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_AB_DeltaV_X_eCall</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_AB_DeltaV_X_eCall</DATA-CONSTR-REF>
                <UNIT-REF DEST="UNIT">/Unit/Unit_Unit_KiloMeterPerHour</UNIT-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-00000131a92e">
          <SHORT-NAME>AB_DeltaV_Y_eCall</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Transmission of the DeltaV lateral during Crash (0-250ms) as additional information for eCall</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_AB_DeltaV_Y_eCall</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_AB_DeltaV_Y_eCall</DATA-CONSTR-REF>
                <UNIT-REF DEST="UNIT">/Unit/Unit_Unit_KiloMeterPerHour</UNIT-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-0000000d516c">
          <SHORT-NAME>AB_EDR_Trigger</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Triggerbedingung zur dezentralen Aufzeichnung unfallrelevanter Daten im Event Data Recorder</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_AB_EDR_Trigger</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_AB_EDR_Trigger</DATA-CONSTR-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-00000001aba0">
          <SHORT-NAME>AB_Erh_Auf_VB</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Der Fahrer soll bei einem Statuswechsel des Beifahrerairbags (ausgelöst durch die Beifahrerinsassenerkennung oder den Schlüsselschloßschalter) aufmerksam gemacht werden durch eine Anzeige im Kombi. Nur Audi: gültig für: AB2 (4-Türer AU352), B7, C6, D3</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_AB_Erh_Auf_VB</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_AB_Erh_Auf_VB</DATA-CONSTR-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-000000016b05">
          <SHORT-NAME>AB_Front_Crash</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Bit wird bei Überschreitung der Gurtstraffer-, US- und RdW-Schwelle gesetzt</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_AB_Front_Crash</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_AB_Front_Crash</DATA-CONSTR-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-000000098654">
          <SHORT-NAME>AB_Gurtschloss_BF</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Gurtschlossstatus Beifahrerseite</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_AB_Gurtschloss_BF</COMPU-METHOD-REF>
