        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-000000d50581">
          <SHORT-NAME>BMC_ThermAuslastung</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">0- hohe Heizanforderung funktionale Einschränkung
26- mittlere Heizanforderung Temperatur anheben
36- kleine Heizanforderung passives Heizen
46- thermischer Wohlfühlbereich keine Kühl-/Heizleistung
56- kleine Kühlstufe Temperatur halten
66- mittlere Kühlstufe Temperatur absenken
76- große Kühlstufe funktionale Einschränkung
101- Notfallkühlung
126- Init
127- Fehler</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_BMC_ThermAuslastung</COMPU-METHOD-REF>
