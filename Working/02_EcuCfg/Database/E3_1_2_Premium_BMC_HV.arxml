        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-000000da5821">
          <SHORT-NAME>BMC_Max_Spannung</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">max. voltage / maximal erlaubte Batteriespannung (zwingend einzuhaltender Grenzwert). Haengt vom Bank status ab. Bei NoBank wird der serielle Wert gesendet</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
