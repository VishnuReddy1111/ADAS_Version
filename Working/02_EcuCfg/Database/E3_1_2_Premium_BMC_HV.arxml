        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-00000120b466">
          <SHORT-NAME>NM_aktiv_VehicleStatReport_Main</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Die Funktion zeigt Daten wie Türen und Fensterstatus oder Reichweiten in der App oder dem Portal an.</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_NM_aktiv_VehicleStatReport_Main</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_NM_aktiv_VehicleStatReport_Main</DATA-CONSTR-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
