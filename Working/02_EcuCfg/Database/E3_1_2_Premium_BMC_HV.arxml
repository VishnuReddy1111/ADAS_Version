          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_OBD_Barometric_Pressure</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_OBD_Barometric_Pressure</DATA-CONSTR-REF>
                <UNIT-REF DEST="UNIT">/Unit/Unit_Unit_KiloPascal</UNIT-REF>
