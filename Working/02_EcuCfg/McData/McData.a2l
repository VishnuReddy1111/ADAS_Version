        MAX_DLC_REQUIRED
        /begin CAN_FD
          MAX_DLC 0x08
          CAN_FD_DATA_TRANSFER_BAUDRATE 0x0F4240
          SAMPLE_POINT 0x50
          BTL_CYCLES 0x0A
          SJW 0x02
          MAX_DLC_REQUIRED
          SECONDARY_SAMPLE_POINT 0x00
          TRANSCEIVER_DELAY_COMPENSATION OFF
        /end CAN_FD
        /begin PROTOCOL_LAYER
