          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-0000011a908a">
          <SHORT-NAME>CHA_FlgGlbFallBkIdc</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Rueckmeldung der Funktion Charisma, ob ein Teilnehmer einen globalen Rueckfall gemeldet bzw. angefordert hat. Das Signal gibt keine Aussage darueber , ob in Folge der Teilnehmer-Meldung auch ein Profil-Wechsel oder eine -Sperrung durchgefuehrt wurde.</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_CHA_FlgGlbFallBkIdc</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_CHA_FlgGlbFallBkIdc</DATA-CONSTR-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
