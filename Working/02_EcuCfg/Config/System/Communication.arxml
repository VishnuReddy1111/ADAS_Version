                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_BMC_PerfInd_Laden</DATA-CONSTR-REF>
                <UNIT-REF DEST="UNIT">/Unit/Unit_Unit_PerCent</UNIT-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-00000121b7ee">
          <SHORT-NAME>BMC_PredLeistung_StuetzungNV</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Entladeleistung der HV Batterie, garantiert für eine Periode von 2,5 Minuten unter der Annahme, dass diese nicht überschritten wird.</L-2>
