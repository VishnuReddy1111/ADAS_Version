            <L-2 L="FOR-ALL">Für MLB:
Berechnung siehe Lastenheft "Kommunikationsabsicherung für FlexRay und CAN"
Ab MQB und MLBevo:
Berechnung siehe Lastenheft "End-to-End Kommunikationsabsicherung"

Endwerte siehe Begleitdokument "S-PDU Kennungsfolgen"</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_VDSO_05_CRC</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_VDSO_05_CRC</DATA-CONSTR-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-00000121b977">
          <SHORT-NAME>VDSO_BasTi200_NumClc_05</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">CalculationNumber of the VDSO 200 Runnable to enable PDU-TLT merge in receiver ECU</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
