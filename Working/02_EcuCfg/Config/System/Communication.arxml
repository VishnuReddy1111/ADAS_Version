          <SHORT-NAME>OBD_QBit_Aussen_Temp</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">QBit der Aussentemperatur. Gesetzt bei Ersatzwert, Init oder Fehler.</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
