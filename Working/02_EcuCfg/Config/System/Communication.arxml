              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-0000013fd6a8">
          <SHORT-NAME>BMC_Bidi_Max_SoC</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Wertebereich: 0 - 100%
Defaultwert: 80%</L-2>
