        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-000000900498">
          <SHORT-NAME>SOK_ungeschuetzte_Zeit</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Periodisch verschickter SOK Zeitwert des SOK Zeitmasters als Referenzzeit zur Erkennung von Clockjitter durch andere SOK Teilnehmer.

Der Empfang dieses Signals ist verpflichtend für jedes Steuergerät, das durch die authentische Broadcast Funktionalität von SOK geschützte Daten versendet oder empfängt.</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_SOK_ungeschuetzte_Zeit</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_SOK_ungeschuetzte_Zeit</DATA-CONSTR-REF>
                <UNIT-REF DEST="UNIT">/Unit/Unit_Unit_None</UNIT-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
