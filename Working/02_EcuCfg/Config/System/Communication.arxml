        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-00000131f733">
          <SHORT-NAME>CHA_FlgEndOfList</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Charisma provides the information to the HMI, if the driver selects the first or the last profile in the profile-list. The signal is sent with the correspondig list-end for a certain-time when the driver activates or reactivates a profile at the end of the list.</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
