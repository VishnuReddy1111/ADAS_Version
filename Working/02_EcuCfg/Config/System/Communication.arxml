        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-000000d69af0">
          <SHORT-NAME>BMC_PerfInd_Entladen</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Der Bereich 100...200% beschreibt die verbleibende Reserve, bis ein Derating der maximalen Entladeleistungsgrenze eintritt. Werte von 0 bis 100% beschreiben, auf welchen Teil der potentiell möglichen maximalen Entladeleistung die Entladeleistungsgrenze zurückgefahren worden ist.</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_BMC_PerfInd_Entladen</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_BMC_PerfInd_Entladen</DATA-CONSTR-REF>
                <UNIT-REF DEST="UNIT">/Unit/Unit_Unit_PerCent</UNIT-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-000000d6961e">
          <SHORT-NAME>BMC_PerfInd_Laden</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Der Bereich 100...200% beschreibt die verbleibende Reserve, bis ein Derating der maximalen Ladeleistungsgrenze eintritt. Werte von 0 bis 100% beschreiben, auf welchen Teil der potentiell möglichen maximalen Ladeleistung die Ladeleistungsgrenze zurückgefahren worden ist.</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
