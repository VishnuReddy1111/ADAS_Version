        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-0000013fd692">
          <SHORT-NAME>BMC_Bidi_Energie_Absolut</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Beschreibt den maximal erlaubten Energiedurchsatz (Absolutwert, für Entladen) für die Funktion Bidi. 
Der Wert dient als zusätzliche Grenze für den Bauteilschutz der Zelle.</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_BMC_Bidi_Energie_Absolut</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_BMC_Bidi_Energie_Absolut</DATA-CONSTR-REF>
                <UNIT-REF DEST="UNIT">/Unit/Unit_Unit_KiloWattHour</UNIT-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-0000013fd696">
          <SHORT-NAME>BMC_Bidi_Freigabe</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Freigabestatus der Funktion Bidi in Abhängigkeit der Ist-Temperatur und des Energiedurchsatzes ermitteln.
Die Basis SW sendet die Information von "Bidi-Status" auf dem CAN Signal BMC_Bidi_Freigabe an das Steuergerät HCP5.</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <COMPU-METHOD-REF DEST="COMPU-METHOD">/Semantics/CM_BMC_Bidi_Freigabe</COMPU-METHOD-REF>
                <DATA-CONSTR-REF DEST="DATA-CONSTR">/Constraints/DC_BMC_Bidi_Freigabe</DATA-CONSTR-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-0000013fd68e">
          <SHORT-NAME>BMC_Bidi_GenutzteEnergie</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Beschreibt den bereits verwendeten Energiedurchsatz (Absolutwert, für Entladen) für die Funktion Bidi.</L-2>
          </DESC>
          <DYNAMIC-LENGTH>false</DYNAMIC-LENGTH>
          <PHYSICAL-PROPS>
