          </PHYSICAL-PROPS>
        </SYSTEM-SIGNAL>
        <SYSTEM-SIGNAL UUID="626a022f-0000-0000-b658-000001744895">
          <SHORT-NAME>BMC_Range_Indikator</SHORT-NAME>
          <DESC>
            <L-2 L="FOR-ALL">Der Range-Indikator gibt das Verhältnis der aktuellen maximalen Reichweite zur maximalen Reichweite eines Neufahrzeugs wieder. Da die Reichweite primär von der UBE abhängt, wird dieser Wert im BMC berechnet</L-2>
          </DESC>
